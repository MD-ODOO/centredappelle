<odoo>

<record id="view_rdv_stage_tree" model="ir.ui.view">
    <field name="name">rdv.stage.tree</field>
    <field name="model">rdv.stage</field>
    <field name="arch" type="xml">
        <list editable="bottom" default_order="sequence asc">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="fold"/>
            <field name="is_done"/>
        </list>
    </field>
</record>

<record id="view_rdv_stage_form" model="ir.ui.view">
    <field name="name">rdv.stage.form</field>
    <field name="model">rdv.stage</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="fold"/>
                    <field name="is_done"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

 <record id="action_rdv_stage" model="ir.actions.act_window">
    <field name="name">Étapes Pipeline</field>
    <field name="res_model">rdv.stage</field>
    <field name="view_mode">list,form</field>
    </record>


</odoo>
