
<odoo>
    
    
 <record id="view_user_tree_rdv"
        model="ir.ui.view">

    <field name="name">res.users.performance.list</field>
    <field name="model">res.users</field>

    <field name="arch" type="xml">
        <list string="Performance Conseillers">

            <field name="name"/>
            <field name="monthly_target"/>
            <field name="rdv_month_count"/>

        </list>
    </field>
</record>

<record id="view_users_performance_form"
        model="ir.ui.view">

    <field name="name">res.users.performance.form</field>
    <field name="model">res.users</field>

    <field name="arch" type="xml">
        <form string="Performance Conseiller">

            <sheet>

                <group string="Objectifs">

                    <field name="name" readonly="1"/>

                    <field name="monthly_target"/>

                    <field name="rdv_month_count" readonly="1"/>

                </group>

                <!-- <group string="Workflow">

                    <field name="stage_counts" readonly="1"/>

                </group> -->

                <notebook>

                    <page string="Rendez-vous">

                        <field name="event_ids">

                            <list>
                                <field name="name"/>
                                <field name="campaign_id"/>
                                <field name="stage_id"/>
                                <field name="start"/>
                            </list>

                        </field>

                    </page>

                </notebook>

            </sheet>

        </form>
    </field>
</record>

<record id="action_users_performance"
        model="ir.actions.act_window">

    <field name="name">Performance Conseillers</field>
    <field name="res_model">res.users</field>
    <field name="view_mode">list,form</field>

</record>


    
</odoo>
