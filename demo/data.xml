<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">


        <!-- Cron qui lance l'automatisation RDV toutes les heures -->
       <record id="ir_cron_rdv_automation" model="ir.cron">
            <field name="name">RDV Automation</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_rdv_automation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>



        <!-- ========================= -->
        <!-- ADMIN -->
        <!-- ========================= -->

        <record id="user_call_admin" model="res.users">
            <field name="name">Admin Call Center</field>
            <field name="login">admin.call</field>
            <field name="email">admin@callcenter.com</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups" eval="[
                (4, ref('base.group_user')),
                (4, ref('oui_allo_rdv_pro.group_call_admin'))
            ]"/>
        </record>

