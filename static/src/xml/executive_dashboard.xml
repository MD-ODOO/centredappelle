<?xml version="1.0" encoding="UTF-8"?>

   <templates xml:space="preserve">
    <t t-name="ExecutiveDashboard">
        <div class="exec-dashboard">

            <!-- ============================= -->
            <!-- FILTRE PERIODE -->
            <!-- ============================= -->
            <div class="dashboard_filters">
                <select t-on-change="changePeriod">
                    <option t-att-selected="state.period==='week'" value="week">Semaine</option>
                    <option t-att-selected="state.period==='month'" value="month">Mois</option>
                    <option t-att-selected="state.period==='quarter'" value="quarter">Trimestre</option>
                    <option t-att-selected="state.period==='year'" value="year">Année</option>
                </select>
            </div>

            <!-- ============================= -->
            <!-- KPI GLOBAUX -->
            <!-- ============================= -->
            <div class="kpi-row">
                <div class="kpi-card blue">
                    <h2 t-esc="state.data.global.total ?? 0"/>
                    <span>Total RDV</span>
                </div>
                <div class="kpi-card green">
                    <h2 t-esc="state.data.global.exploite ?? 0"/>
                    <span>Exploités</span>
                </div>
                <div class="kpi-card red">
                    <h2 t-esc="state.data.global.absent ?? 0"/>
                    <span>No Show</span>
                </div>
                <div class="kpi-card purple">
                    <h2 t-esc="(state.data.global.taux_exploitation ?? 0).toFixed(1)"/>%
                    <span>Taux exploitation</span>
                </div>
            </div>

            <!-- ============================= -->
            <!-- KPI AUJOURD'HUI -->
            <!-- ============================= -->
            <div class="kpi-row">
                <div class="kpi-card orange">
                    <h2 t-esc="state.data.today.total ?? 0"/>
                    <span>RDV Aujourd'hui</span>
                </div>
                <div class="kpi-card green">
                    <h2 t-esc="state.data.today.exploite ?? 0"/>
                    <span>Exploités Aujourd'hui</span>
                </div>
                <div class="kpi-card red">
                    <h2 t-esc="state.data.today.absent ?? 0"/>
                    <span>No Show Aujourd'hui</span>
                </div>
                <div class="kpi-card blue">
                    <h2 t-esc="state.data.today.conseillers ?? 0"/>
                    <span>Conseillers actifs</span>
                </div>
            </div>

            <!-- ============================= -->
            <!-- TABLE RDV PAR DATE -->
            <!-- ============================= -->
            <div class="section">
                <div class="table-card">
                    <h3>Rendez-vous par date</h3>
                    <div class="table-scroll">
                        <table class="exec-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Campagne</th>
                                    <th>Conseiller</th>
                                    <th>Pris</th>
                                    <th>Exploités</th>
                                    <th>No Show</th>
                                    <th>Reporté</th>
                                    <th>Taux</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.rdv_by_date" t-as="r" t-key="r.id">
                                    <tr>
                                        <td><t t-esc="r.date"/></td>
                                        <td><strong t-esc="r.campaign"/></td>
                                        <td><t t-esc="r.conseiller"/></td>
                                        <td><t t-esc="r.pris ?? 0"/></td>
                                        <td><span class="badge-green"><t t-esc="r.exploite ?? 0"/></span></td>
                                        <td><span class="badge-red"><t t-esc="r.absent ?? 0"/></span></td>
                                        <td><span class="badge-orange"><t t-esc="r.reporte ?? 0"/></span></td>
                                        <td><span t-att-class="getPerformanceClass(r.taux)"><t t-esc="(r.taux ?? 0).toFixed(1)"/>%</span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================= -->
            <!-- TOP 5 CAMPAGNES ET CONSEILLERS -->
            <!-- ============================= -->
            <div class="top-row">

                <!-- TOP CAMPAGNES -->
                <div class="top_card">
                    <h3>Top 5 campagnes</h3>
                    <t t-if="state.data.top_campaigns">
                        <t t-set="i" t-value="0"/>
                        <t t-foreach="state.data.top_campaigns" t-as="camp" t-key="camp.id">
                            <t t-set="i" t-value="i+1"/>
                            <div class="top_item" t-on-click="() => openCampaign(camp.id)">
                                <div class="top_rank"><t t-esc="i"/></div>
                                <div class="top_content">
                                    <strong t-esc="camp.name"/>
                                    <span>Exploités : <t t-esc="camp.exploite"/> (<t t-esc="camp.taux_exploitation.toFixed(1)"/>%)</span>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

                <!-- TOP CONSEILLERS -->
                <div class="top_card">
                    <h3>Top 5 conseillers</h3>
                    <t t-if="state.data.top_conseillers">
                        <t t-set="i" t-value="0"/>
                        <t t-foreach="state.data.top_conseillers" t-as="cons" t-key="cons.id">
                            <t t-set="i" t-value="i+1"/>
                            <div class="top_item" t-on-click="() => openConseiller(cons.id)">
                                <div class="top_rank"><t t-esc="i"/></div>
                                <div class="top_content">
                                    <strong t-esc="cons.name"/>
                                    <span>Exploités : <t t-esc="cons.exploite"/> (<t t-esc="cons.taux_exploitation.toFixed(1)"/>%)</span>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

            </div>

            <!-- ============================= -->
            <!-- GRAPHIQUES -->
            <!-- ============================= -->
            <div class="chart_grid">
                <div class="chart_card">
                    <h3>Pie Campagnes</h3>
                    <canvas id="pieCampaigns"></canvas>
                </div>
                <div class="chart_card">
                    <h3>Pie Conseillers</h3>
                    <canvas id="pieConseillers"></canvas>
                </div>
                <div class="chart_card">
                    <h3>Performance Conseillers</h3>
                    <canvas id="barPerformance"></canvas>
                </div>
                <div class="chart_card">
                    <h3>Evolution RDV</h3>
                    <canvas id="monthlyEvolution"></canvas>
                </div>
            </div>

            <!-- ============================= -->
            <!-- TABLE PERFORMANCE CONSEILLERS ET CAMPAGNES -->
            <!-- ============================= -->
            <div class="section flex-row">

                <!-- CONSEILLERS -->
                <div class="table-card">
                    <h3>Performance conseillers</h3>
                    <div class="table-scroll">
                        <table class="exec-table">
                            <thead>
                                <tr>
                                    <th>Conseiller</th>
                                    <th>Pris</th>
                                    <th>Exploités</th>
                                    <th>Absents</th>
                                    <th>Taux</th>
                                    <th>Objectif</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.conseillers" t-as="c" t-key="c.id">
                                    <tr t-on-click="() => openConseiller(c.id)">
                                        <td><t t-esc="c.name"/></td>
                                        <td><t t-esc="c.pris"/></td>
                                        <td><t t-esc="c.exploite"/></td>
                                        <td><t t-esc="c.absent"/></td>
                                        <td><span t-att-class="getPerformanceClass(c.taux_exploitation)"><t t-esc="c.taux_exploitation.toFixed(1)"/>%</span></td>
                                        <td><span t-att-class="c.objectif_atteint ? 'badge-green':'badge-red'"><t t-esc="c.objectif"/></span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CAMPAGNES -->
                <div class="table-card">
                    <h3>Performance campagnes</h3>
                    <div class="table-scroll">
                        <table class="exec-table">
                            <thead>
                                <tr>
                                    <th>Campagne</th>
                                    <th>Commandés</th>
                                    <th>Pris</th>
                                    <th>Exploités</th>
                                    <th>Absents</th>
                                    <th>Reportés</th>
                                    <th>Restants</th>
                                    <th>Taux</th>
                                    <th t-if="state.data.is_admin">Prix</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.campagnes" t-as="camp" t-key="camp.id">
                                    <tr t-on-click="() => openCampaign(camp.id)">
                                        <td><strong t-esc="camp.name"/></td>
                                        <td><t t-esc="camp.commande"/></td>
                                        <td><t t-esc="camp.pris"/></td>
                                        <td><span class="badge-green"><t t-esc="camp.exploite"/></span></td>
                                        <td><span class="badge-red"><t t-esc="camp.absent"/></span></td>
                                        <td><span class="badge-orange"><t t-esc="camp.reporte"/></span></td>
                                        <td><t t-esc="camp.restant"/></td>
                                        <td><span t-att-class="getPerformanceClass(camp.taux_exploitation)"><t t-esc="camp.taux_exploitation.toFixed(1)"/>%</span></td>
                                        <td t-if="state.data.is_admin"><t t-esc="camp.price_paid"/> €</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </t>
</templates>

